# ── 데이터베이스 ──
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB"

# ── 인증 (자체 JWT) ──
JWT_ACCESS_SECRET=""          # openssl rand -base64 32
JWT_REFRESH_SECRET=""         # 위와 다른 값
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="14d"

# ── 소셜 로그인 (OAuth 2.0) ──
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""
OAUTH_REDIRECT_BASE="http://localhost:3000"

# ── AI 범위 분해 ── OPENAI_API_KEY 우선, 없으면 ANTHROPIC_API_KEY, 둘 다 없으면 규칙 기반 폴백(model: "rule")
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"

# ── 결제 (토스페이먼츠, 반드시 sandbox) ── developers.tosspayments.com > API 키 > "API 개별 연동 키"
NEXT_PUBLIC_TOSS_CLIENT_KEY=""  # test_ck_… 만. live_ 접두사는 서버가 거부한다
TOSS_SECRET_KEY=""              # test_sk_… 만
PLATFORM_FEE_RATE="0.10"
# E2E 전용: 1 이면 paymentKey 가 "simulated_" 로 시작하는 승인 요청을 PG 호출 없이 통과시킨다. 운영에는 절대 두지 않는다.
ALLOW_PAYMENT_SIMULATION=""

# ── 스토리지 (프로필 이미지, Vercel Blob) ── `vercel blob create-store` 로 연결하면 자동 주입
BLOB_READ_WRITE_TOKEN=""

# ── 분석 ──
NEXT_PUBLIC_GA_ID=""
